import random
from random import randint

# =====================================================================
# SYSTEMA DE GESTIÓN DE ARCHIVOS Y RANKINGS (PERSISTENCIA DE DATOS)
# =====================================================================

def guardar_puntaje(juego: str, nombre: str, puntaje: int):
    """
    Registra o actualiza el puntaje de un jugador en un archivo de texto.
    
    Si el jugador ya existe en el historial, acumula los puntos obtenidos.
    Maneja la excepción si el archivo aún no ha sido creado.
    """
    archivo = juego + "_ranking.txt"
    datos = {}

    # Lectura del historial existente
    try:
        with open(archivo, "r", encoding="utf-8") as f:
            for linea in f:
                # Separamos el nombre del puntaje usando la coma como delimitador
                nom, pts = linea.strip().split(",")
                datos[nom] = int(pts)
    except FileNotFoundError:
        # Si el archivo no existe, se ignora el error para crearlo al escribir
        pass

    # Actualización o inserción del nuevo puntaje en el diccionario
    if nombre in datos:
        datos[nombre] += puntaje
    else:
        datos[nombre] = puntaje

    # Escritura y actualización del archivo de texto
    with open(archivo, "w", encoding="utf-8") as f:
        for nom, pts in datos.items():
            f.write(f"{nom},{pts}\n")


def mostrar_ranking(juego: str):
    """
    Lee los puntajes desde el archivo correspondiente, los ordena de mayor 
    a menor e imprime en consola el Top 10 de jugadores.
    """
    archivo = juego + "_ranking.txt"

    try:
        with open(archivo, "r", encoding="utf-8") as f:
            datos = []
            for linea in f:
                nombre, puntaje = linea.strip().split(",")
                datos.append((nombre, int(puntaje)))

        # Ordenamos la lista de tuplas por el segundo elemento (puntaje) de forma descendente
        datos.sort(key=lambda x: x[1], reverse=True)

        print("\n===== RANKING =====")
        puesto = 1
        # Mostramos únicamente los primeros 10 puestos usando rebanado de listas (slicing)
        for nombre, puntaje in datos[:10]:
            print(f"{puesto}. {nombre} - {puntaje}")
            puesto += 1

    except FileNotFoundError:
        print("\nTodavía no hay puntajes registrados para este juego.")


