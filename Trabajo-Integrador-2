def mostrar_tablero(tablero: list):
    """
    Dibuja en la terminal la matriz unidimensional formateada como 
    un tablero clásico bidimensional de 3x3.
    """
    print()
    print(" ", tablero[0], "|", tablero[1], "|", tablero[2])
    print("---+---+---")
    print(" ", tablero[3], "|", tablero[4], "|", tablero[5])
    print("---+---+---")
    print(" ", tablero[6], "|", tablero[7], "|", tablero[8])
    print()


def verificar_ganador(tablero: list, jugador: str) -> bool:
    """
    Compara las posiciones del tablero con las 8 combinaciones posibles de victoria.
    Devuelve True si el jugador actual alineó tres de sus caracteres.
    """
    # Mapeo de índices de todas las líneas rectas posibles en el tablero
    combinaciones = [
        [0,1,2], [3,4,5], [6,7,8],  # Horizontales
        [0,3,6], [1,4,7], [2,5,8],  # Verticales
        [0,4,8], [2,4,6]            # Diagonales
    ]

    for g in combinaciones:
        if tablero[g[0]] == tablero[g[1]] == tablero[g[2]] == jugador:
            return True
    return False


def jugar_tateti():
    """
    Controla el ciclo principal del juego Ta-Te-Ti. Gestiona los turnos,
    valida las entradas de las celdas y procesa las victorias o empates.
    """
    # Inicializamos el tablero con los números de guía visual para el usuario
    tablero = ["1","2","3",
               "4","5","6",
               "7","8","9"]
    jugador = "X"
    jugadas = 0

    while True:
        print("\n========== TA-TE-TI ==========")
        mostrar_tablero(tablero)

        # Validación contra ingresos de texto o errores de casillas vacías
        try:
            pos = int(input(f"Jugador {jugador}, elija una posición (1-9): ")) - 1
        except ValueError:
            print("Error: Ingrese un número entero válido.")
            continue

        # Validación de rango de matriz
        if pos < 0 or pos > 8:
            print("Posición inválida. Debe ser del 1 al 9.")
            continue

        # Validación de superposición de fichas
        if tablero[pos] == "X" or tablero[pos] == "O":
            print("Esa casilla ya está ocupada.")
            continue

        # Realizar jugada y cambiar estado del juego
        tablero[pos] = jugador
        jugadas += 1

        if verificar_ganador(tablero, jugador):
            mostrar_tablero(tablero)
            print(f"\n¡¡Ganó el jugador {jugador}!!")
            nombre = input("Nombre del ganador: ").strip()
            if not nombre: nombre = "Anónimo" # Evita guardar nombres vacíos
            guardar_puntaje("tateti", nombre, 1)
            break

        if jugadas == 9:
            mostrar_tablero(tablero)
            print("\nEmpate. El tablero está lleno.")
            break

        # Alternancia de turnos mediante condicional lógico
        jugador = "O" if jugador == "X" else "X"

    input("\nPresione ENTER para volver al menú...")


# =====================================================================
# JUEGO 2: ¿CUÁNTO CONOCES LOS NÚMEROS?
# =====================================================================

def cuantos_conoces_los_numeros() -> tuple:
    """
    Juego de operaciones matemáticas aleatorias con 3 niveles de dificultad.
    Evalúa la velocidad matemática del usuario y retorna sus datos de partida.
    """
    puntos = 0

    print("\n********************************")
    print("¿CUÁNTO CONOCES LOS NÚMEROS?")
    print("********************************")

    # Bucle de validación para asegurar que el nombre no sea enviado en blanco
    nombre = input("\nIngresa tu nombre: ").strip()
    while not nombre:
        print("El nombre no puede estar vacío.")
        nombre = input("Ingresa tu nombre: ").strip()

    print("\nElegí dificultad:")
    print("1- Fácil   (suma y resta, números hasta 10, 5 preguntas)")
    print("2- Medio   (suma, resta y multiplicación, hasta 50, 7 preguntas)")
    print("3- Difícil (todas las operaciones, hasta 100, 10 preguntas)")

    # Configuración del entorno matemático según dificultad elegida
    while True:
        dificultad = input("Opción: ").strip()
        if dificultad == "1":
            maximo = 10
            operaciones = ["+", "-"]
            cantidad = 5
            break
        elif dificultad == "2":
            maximo = 50
            operaciones = ["+", "-", "*"]
            cantidad = 7
            break
        elif dificultad == "3":
            maximo = 100
            operaciones = ["+", "-", "*", "/"]
            cantidad = 10
            break
        else:
            print("Opción inválida. Ingresa 1, 2 o 3.")

    # Ciclo de preguntas dinámicas
    for i in range(cantidad):
        num1 = random.randint(1, maximo)
        num2 = random.randint(1, maximo)
        operacion = random.choice(operaciones)

        # Resolución exacta del cálculo real en background
        if operacion == "+":
            resultado = num1 + num2
        elif operacion == "-":
            resultado = num1 - num2
        elif operacion == "*":
            resultado = num1 * num2
        else:
            # Para evitar decimales infinitos, transformamos en una división exacta múltiplo
            num1 = num1 * num2
            resultado = num1 // num2

        # El juego decide al azar si le va a mostrar la respuesta correcta o una alterada
        correcta = random.choice([True, False])

        if correcta:
            respuesta_mostrada = resultado
        else:
            desvio = random.randint(1, 10) * random.choice([1, -1])
            respuesta_mostrada = resultado + desvio
            if respuesta_mostrada == resultado:
                respuesta_mostrada += 1

        print(f"\nPregunta {i+1} de {cantidad}")
        print(f"¿Cuánto es {num1} {operacion} {num2}?")
        print(f"Respuesta propuesta: {respuesta_mostrada}")
        print("1- Es correcto")
        print("2- Es incorrecto")
        print("3- Salir")

        while True:
            opcion = input("Elegí: ").strip()
            if opcion in ["1", "2", "3"]:
                break
            print("Opción inválida. Ingresa 1, 2 o 3.")

        if opcion == "3":
            print("Saliste del juego.")
            break

        # Verificación lógica de la respuesta del usuario frente al entorno real
        if (opcion == "1" and correcta) or (opcion == "2" and not correcta):
            print("¡Correcto! +10 puntos")
            puntos += 10
        else:
            if correcta:
                print(f"Incorrecto. La respuesta {respuesta_mostrada} SÍ era correcta.")
            else:
                print(f"Incorrecto. La respuesta {respuesta_mostrada} era falsa. El resultado real es {resultado}.")

    print("\nJuego terminado")
    print(f"Puntaje final de {nombre}: {puntos} pts")
    return nombre, puntos


