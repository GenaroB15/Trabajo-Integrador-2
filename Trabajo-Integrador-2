def mostrar_bienvenida():
    """Muestra la interfaz inicial visual y las reglas de Adivina el Número."""
    print("\n" + "="*40)
    print("      ¡BIENVENIDO A ADIVINA EL NÚMERO!      ")
    print("="*40)
    print("Pensé un número entre 1 y 100.")
    print("Intentá adivinarlo. Te iré guiando si es mayor o menor.\n")


def solicitar_numero() -> int:
    """
    Solicita un número al usuario y fuerza la validación mediante bucle 
    hasta garantizar que ingresó un número entero válido o el comando de escape 0.
    """
    while True:
        entrada = input("Ingresá tu número (O ingresá 0 para abandonar): ").strip()
        
        # Validación robusta de tipo de dato
        if entrada.isdigit():
            return int(entrada)
        else:
            print("Entrada inválida. Por favor, ingresá un número entero.")


def jugar_adivina_numero():
    """
    Ciclo de juego de adivinación numérica interactiva.
    Calcula un puntaje decreciente según la cantidad de intentos fallidos.
    """
    mostrar_bienvenida()

    numero_secreto = random.randint(1, 100)
    intentos = 0
    adivinado = False

    while not adivinado:
        numero_usuario = solicitar_numero()

        # Ruta de salida anticipada hacia el menú
        if numero_usuario == 0:
            print("\nVolviendo al menú principal...\n")
            return

        intentos += 1

        if numero_usuario < numero_secreto:
            print("El número secreto es MAYOR. ¡Intentá de nuevo!")
        elif numero_usuario > numero_secreto:
            print("El número secreto es MENOR. ¡Intentá de nuevo!")
        else:
            print(f"\n¡EXCELENTE! Adivinaste el número secreto ({numero_secreto}).")
            print(f"Te tomó un total de {intentos} intentos.")
            
            nombre = input("Ingrese su nombre para el ranking: ").strip()
            if not nombre: nombre = "Jugador S/N"
            
            # Algoritmo de ponderación: premia al que adivinó con menos intentos
            puntaje = max(0, 100 - intentos * 10)

            guardar_puntaje("adivina", nombre, puntaje)
            adivinado = True

    input("\nPresioná ENTER para volver al menú...")


# =====================================================================
# JUEGO 4: EL AHORCADO
# =====================================================================

def ahorcado():
    """
    Juego del ahorcado tradicional procesado a través del manejo de listas de letras.
    Finaliza al quedarse sin vidas o al completar los caracteres del string aleatorio.
    """
    palabras = ["panadero", "dinosaurio", "helipuerto", "tiburon"]
    # Selección de palabra por índice dinámico basado en la longitud del vector
    palabra = palabras[randint(0, len(palabras) - 1)]

    vidas = 6
    letras_correctas = []
    letras_incorrectas = []

    while vidas > 0:
        print("\nPalabra:")
        gano = True

        # Renderizado interactivo de la palabra oculta
        for letra in palabra:
            if letra in letras_correctas:
                print(letra, end=" ")
            else:
                print("_", end=" ")
                gano = False  # Si falta al menos una letra, no puede ganar todavía

        print("\n")
        print("Vidas restantes:", vidas)
        print("Letras incorrectas probadas:", letras_incorrectas)

        if gano:
            print("\n¡¡GANASTE!!")
            nombre = input("Ingrese su nombre para el registro: ").strip()
            if not nombre: nombre = "Superviviente"
            puntaje = vidas * 10
            guardar_puntaje("ahorcado", nombre, puntaje)
            input("Presione ENTER para volver al menú...")
            return

        letra = input("Ingrese una letra (O ingrese 0 para abandonar): ").lower().strip()

        if letra == "0":
            print("\nVolviendo al menú principal...")
            return

        # Control de robustez ante entradas vacías o múltiples caracteres (ej: palabras enteras)
        if len(letra) != 1 or not letra.isalpha():
            print("Error: Ingrese estrictamente una sola letra.")
            continue

        # Evita penalizar al usuario si vuelve a ingresar caracteres repetidos
        if letra in letras_correctas or letra in letras_incorrectas:
            print("Ya ingresaste esa letra anteriormente. Intentá otra.")
            continue

        # Evaluación lógica de coincidencia
        if letra in palabra:
            letras_correctas.append(letra)
            print("¡Correcto!")
        else:
            letras_incorrectas.append(letra)
            vidas -= 1
            print("Incorrecto. Perdiste una vida.")

    # Fin del juego por pérdida de recursos (vidas = 0)
    print("\nPerdiste por completo.")
    print("La palabra oculta era:", palabra)
    nombre = input("Ingrese su nombre para dejar registro: ").strip()
    if not nombre: nombre = "Jugador Sin Vidas"
    guardar_puntaje("ahorcado", nombre, 0)
    input("Presione ENTER para volver al menú...")


# =====================================================================
# ENTORNO INTERFACES DE MENÚS (CONTROLADOR CENTRAL)
# =====================================================================

def menu_rankings():
    """
    Submenú interactivo para navegar las estadísticas históricas 
    guardadas de cada módulo de juego.
    """
    while True:
        print("\n===== RANKINGS HISTÓRICOS =====")
        print("1 - Ta-Te-Ti")
        print("2 - Cuánto conoces los números")
        print("3 - Adivina el número")
        print("4 - Ahorcado")
        print("0 - Volver al Menú Principal")

        opcion = input("Seleccione una opción: ").strip()

        if opcion == "1":
            mostrar_ranking("tateti")
        elif opcion == "2":
            mostrar_ranking("numeros")
        elif opcion == "3":
            mostrar_ranking("adivina")
        elif opcion == "4":
            mostrar_ranking("ahorcado")
        elif opcion == "0":
            break # Rompe el ciclo interno regresando al flujo del menú principal
        else:
            print("Opción incorrecta. Ingrese un número del 0 al 4.")

        input("\nPresione ENTER para continuar...")


def menu():
    """
    Función de arranque del programa central. Administra el bucle máster
    y redirige el flujo de ejecución hacia los diferentes módulos de juego.
    """
    opcion = -1

    while opcion != 0:
        print("\n==============================")
        print("       JUEGOS                  ")
        print("==============================")
        print("1 - Ta-Te-Ti")
        print("2 - ¿Cuánto conoces los números?")
        print("3 - Adivina el número")
        print("4 - Ahorcado")
        print("5 - Ver Tabla de Rankings")
        print("0 - Salir del Sistema")

        # Robustez contra ingresos maliciosos no numéricos en el menú raíz
        try:
            opcion = int(input("Seleccione una opción: "))
        except ValueError:
            print("Error: Por favor, ingrese un número entero válido.")
            continue

        # Redirección selectiva estructurada
        if opcion == 1:
            jugar_tateti()
        elif opcion == 2:
            nombre, puntos = cuantos_conoces_los_numeros()
            guardar_puntaje("numeros", nombre, puntos)
        elif opcion == 3:
            jugar_adivina_numero()
        elif opcion == 4:
            ahorcado()
        elif opcion == 5:
            menu_rankings()
        elif opcion == 0:
            print("\nGracias por utilizar nuestra plataforma. ¡Hasta luego!")
        else:
            print("Opción incorrecta. Elija un número de las opciones mostradas.")


# Punto de entrada de ejecución nativo del Script
if __name__ == "__main__":
    menu()