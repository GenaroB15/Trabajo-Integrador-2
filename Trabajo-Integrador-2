def mostrar_tablero(tablero):
    print()
    print(" ", tablero[0], "|", tablero[1], "|", tablero[2])
    print("---+---+---")
    print(" ", tablero[3], "|", tablero[4], "|", tablero[5])
    print("---+---+---")
    print(" ", tablero[6], "|", tablero[7], "|", tablero[8])
    print()


def verificar_ganador(tablero, jugador):
    combinaciones = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]

    for c in combinaciones:
        if tablero[c[0]] == tablero[c[1]] == tablero[c[2]] == jugador:
            return True
    return False


def jugar_tateti():
    tablero = ["1","2","3",
               "4","5","6",
               "7","8","9"]

    jugador = "X"
    jugadas = 0

    while True:
        print("\n========== TA-TE-TI ==========")
        mostrar_tablero(tablero)

        try:
            pos = int(input(f"Jugador {jugador}, elija una posición (1-9): ")) - 1
        except:
            print("Ingrese un número.")
            continue

        if pos < 0 or pos > 8:
            print("Posición inválida.")
            continue

        if tablero[pos] == "X" or tablero[pos] == "O":
            print("Esa casilla ya está ocupada.")
            continue

        tablero[pos] = jugador
        jugadas += 1

        if verificar_ganador(tablero, jugador):
            mostrar_tablero(tablero)
            print(f"\n¡¡Ganó el jugador {jugador}!!")
            break

        if jugadas == 9:
            mostrar_tablero(tablero)
            print("\nEmpate.")
            break

        if jugador == "X":
            jugador = "O"
        else:
            jugador = "X"

    input("\nPresione ENTER para volver al menú...")

import random

def mostrar_bienvenida():
    """Muestra el mensaje inicial y las reglas del juego."""
    print("\n" + "="*40)
    print("      ¡BIENVENIDO A ADIVINA EL NÚMERO!      ")
    print("="*40)
    print("Pensé un número entre 1 y 100.")
    print("Intentá adivinarlo. Te iré guiando si es mayor o menor.\n")

def solicitar_numero() -> int:
    """Solicita un número al usuario y valida que sea un entero válido."""
    while True:
        entrada = input("Ingresá tu número: ").strip()
        
        # Validación de datos: nos aseguramos de que sea un número entero
        if entrada.isdigit():
            return int(entrada)
        else:
            print("Entrada inválida. Por favor, ingresá un número entero.")

def jugar_adivina_numero():
    """Función principal que contiene la lógica del juego."""
    mostrar_bienvenida()
    
    # Selección del número al azar entre 1 y 100
    numero_secreto = random.randint(1, 100)
    intentos = 0
    adivinado = False
    
    # Bucle principal del juego
    while not adivinado:
        numero_usuario = solicitar_numero()
        intentos += 1
        
        if numero_usuario < numero_secreto:
            print(" El número secreto es MAYOR. ¡Intentá de nuevo!")
        elif numero_usuario > numero_secreto:
            print(" El número secreto es MENOR. ¡Intentá de nuevo!")
        else:
            print(f"\n ¡EXCELENTE! Adivinaste el número secreto ({numero_secreto}).")
            print(f" Te tomó un total de {intentos} intentos.")
            adivinado = True
            
    print("="*40 + "\n")

  

