def mostrar_tablero(tablero):
    print()
    print(" ", tablero[0], "|", tablero[1], "|", tablero[2])
    print("---+---+---")
    print(" ", tablero[3], "|", tablero[4], "|", tablero[5])
    print("---+---+---")
    print(" ", tablero[6], "|", tablero[7], "|", tablero[8])
    print()


def verificar_ganador(tablero, jugador):
    combinaciones = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]

    for g in combinaciones:
        if tablero[g[0]] == tablero[g[1]] == tablero[g[2]] == jugador:
            return True
    return False


def jugar_tateti():
    tablero = ["1","2","3",
               "4","5","6",
               "7","8","9"]

    jugador = "X"
    jugadas = 0

    while True:
        print("\n========== TA-TE-TI ==========")
        mostrar_tablero(tablero)

        try:
            pos = int(input(f"Jugador {jugador}, elija una posición (1-9): ")) - 1
        except:
            print("Ingrese un número.")
            continue

        if pos < 0 or pos > 8:
            print("Posición inválida.")
            continue

        if tablero[pos] == "X" or tablero[pos] == "O":
            print("Esa casilla ya está ocupada.")
            continue

        tablero[pos] = jugador
        jugadas += 1

        if verificar_ganador(tablero, jugador):
            mostrar_tablero(tablero)
            print(f"\n¡¡Ganó el jugador {jugador}!!")
            break

        if jugadas == 9:
            mostrar_tablero(tablero)
            print("\nEmpate.")
            break

        if jugador == "X":
            jugador = "O"
        else:
            jugador = "X"

    input("\nPresione ENTER para volver al menú...")

import random

def cuantos_conoces_los_numeros():
    puntos = 0

    print("\n********************************")
    print("CUANTO CONOCES LOS NUMEROS?")
    print("********************************")

    nombre = input("\nIngresa tu nombre: ").strip()
    while not nombre:
        print("El nombre no puede estar vacio.")
        nombre = input("Ingresa tu nombre: ").strip()

    print("\nElegi dificultad:")
    print("1- Facil   (suma y resta, numeros hasta 10, 5 preguntas)")
    print("2- Medio   (suma, resta y multiplicacion, hasta 50, 7 preguntas)")
    print("3- Dificil (todas las operaciones, hasta 100, 10 preguntas)")

    while True:
        dificultad = input("Opcion: ").strip()
        if dificultad == "1":
            maximo      = 10
            operaciones = ["+", "-"]
            cantidad    = 5
            break
        elif dificultad == "2":
            maximo      = 50
            operaciones = ["+", "-", "*"]
            cantidad    = 7
            break
        elif dificultad == "3":
            maximo      = 100
            operaciones = ["+", "-", "*", "/"]
            cantidad    = 10
            break
        else:
            print("Opcion invalida. Ingresa 1, 2 o 3.")

    for i in range(cantidad):
        num1      = random.randint(1, maximo)
        num2      = random.randint(1, maximo)
        operacion = random.choice(operaciones)

        if operacion == "+":
            resultado = num1 + num2
        elif operacion == "-":
            resultado = num1 - num2
        elif operacion == "*":
            resultado = num1 * num2
        else:
            num1      = num1 * num2
            resultado = num1 // num2

        correcta = random.choice([True, False])

        if correcta:
            respuesta_mostrada = resultado
        else:
            desvio             = random.randint(1, 10) * random.choice([1, -1])
            respuesta_mostrada = resultado + desvio
            if respuesta_mostrada == resultado:
                respuesta_mostrada += 1

        print(f"\nPregunta {i+1} de {cantidad}")
        print(f"Cuanto es {num1} {operacion} {num2}?")
        print(f"Respuesta: {respuesta_mostrada}")
        print("1- Es correcto")
        print("2- Es incorrecto")
        print("3- Salir")

        while True:
            opcion = input("Elegi: ").strip()
            if opcion in ["1", "2", "3"]:
                break
            print("Opcion invalida. Ingresa 1, 2 o 3.")

        if opcion == "3":
            print("Saliste del juego.")
            break

        if (opcion == "1" and correcta) or (opcion == "2" and not correcta):
            print("Correcto! +10 puntos")
            puntos += 10
        else:
            if correcta:
                print(f"Incorrecto. La respuesta {respuesta_mostrada} era correcta.")
            else:
                print(f"Incorrecto. La respuesta {respuesta_mostrada} era falsa. El resultado real es {resultado}.")

    print("\nJuego terminado")
    print(f"Puntaje final: {puntos} pts")
    return nombre, puntos

import random

def mostrar_bienvenida():
    """Muestra el mensaje inicial y las reglas del juego."""
    print("\n" + "="*40)
    print("      ¡BIENVENIDO A ADIVINA EL NÚMERO!      ")
    print("="*40)
    print("Pensé un número entre 1 y 100.")
    print("Intentá adivinarlo. Te iré guiando si es mayor o menor.\n")

def solicitar_numero() -> int:
    """Solicita un número al usuario y valida que sea un entero válido."""
    while True:
        entrada = input("Ingresá tu número: ").strip()
        
        # Validación de datos: nos aseguramos de que sea un número entero
        if entrada.isdigit():
            return int(entrada)
        else:
            print("Entrada inválida. Por favor, ingresá un número entero.")

def jugar_adivina_numero():
    """Función principal que contiene la lógica del juego."""
    mostrar_bienvenida()
    
    # Selección del número al azar entre 1 y 100
    numero_secreto = random.randint(1, 100)
    intentos = 0
    adivinado = False
    
    # Bucle principal del juego
    while not adivinado:
        numero_usuario = solicitar_numero()
        intentos += 1
        
        if numero_usuario < numero_secreto:
            print(" El número secreto es MAYOR. ¡Intentá de nuevo!")
        elif numero_usuario > numero_secreto:
            print(" El número secreto es MENOR. ¡Intentá de nuevo!")
        else:
            print(f"\n ¡EXCELENTE! Adivinaste el número secreto ({numero_secreto}).")
            print(f" Te tomó un total de {intentos} intentos.")
            adivinado = True
            
    print("="*40 + "\n")

def menu():
    opcion = -1

    while opcion != 0:
        print("\n==============================")
        print("      Bienvenido  ")
        print("==============================")
        print("1 - Ta-Te-Ti")
        print("2 - Cuantos conoces los numeros?")
        print("3 - Adivina el número")
        print("4 - Juego 4")
        print("0 - Salir")

        try:
            opcion = int(input("Seleccione una opción: "))
        except:
            print("Ingrese un número válido.")
            continue

        if opcion == 1:
            jugar_tateti()

        elif opcion == 2:
            cuantos_conoces_los_numeros()

        elif opcion == 3:
            jugar_adivina_numero()

        elif opcion == 4:
            print("\nJuego en desarrollo...")
            input("Presione ENTER para volver al menú.")

        elif opcion == 0:
            print("\nGracias por jugar.")

        else:
            print("Opción incorrecta.")


menu()